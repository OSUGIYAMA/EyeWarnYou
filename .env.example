# Optional. The Anthropic API key can also be set in Settings (stored in the local database).
ANTHROPIC_API_KEY=
# Port for `npm start` (default 8787) and bind address (default 127.0.0.1)
PORT=8787
HOST=127.0.0.1
# Protect a shared deployment with HTTP basic auth
EYEWARNYOU_PASSWORD=
EYEWARNYOU_USER=eyewarnyou
# Where the SQLite database lives (default ./var/eyewarnyou.db)
EYEWARNYOU_DB=
