{
  "name": "kanmon",
  "version": "2.0.0",
  "private": true,
  "description": "Kanmon — an economic-security workbench: export controls under Japanese, US and Chinese law, restricted-party screening across US, Japanese and Chinese lists, and regulatory intelligence.",
  "license": "Apache-2.0",
  "author": "Tatsuya Sugiyama",
  "repository": {
    "type": "git",
    "url": "https://github.com/OSUGIYAMA/export-control-ai-assistant.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch --clear-screen=false src/server/main.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build --logLevel warn && NODE_ENV=production tsx src/server/main.ts",
    "sync": "tsx scripts/sync.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "demo": "tsx scripts/seed-demo.ts",
    "serve": "NODE_ENV=production tsx src/server/main.ts",
    "evaluate": "tsx scripts/evaluate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@hono/node-server": "^2.1.3",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.104.0",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "exceljs": "^4.4.0",
    "hono": "^4.13.11",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.13.0",
    "minisearch": "^7.2.0",
    "nanoid": "^5.1.16",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "unpdf": "^1.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
